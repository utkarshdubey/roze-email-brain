# OpenAI API key (platform.openai.com). The only value a fresh clone needs.
OPENAI_API_KEY=

# Google sign-in. The project's public OAuth client and the small proxy that holds its secret are the
# defaults (src/gmail/auth.ts), so leave these alone unless you run your own. Setting GOOGLE_CLIENT_SECRET
# switches to exchanging tokens directly with Google, bypassing the proxy.
# GOOGLE_CLIENT_ID=<the project's public client id>
# ROZE_TOKEN_PROXY=https://roze-token-proxy.kaneki.workers.dev
# GOOGLE_CLIENT_SECRET=

# Optional model overrides (defaults in src/llm/models.ts)
# ROZE_MODEL_ANSWER=gpt-5.4          # gpt-5.4-mini answers at a third of the cost with markedly lower accuracy on multi-thread questions
# ROZE_MODEL_EXTRACT=gpt-5-nano
# ROZE_MODEL_PROMOTE=gpt-5.4-mini
# ROZE_MODEL_TAG=gpt-5-nano
# ROZE_MODEL_JUDGE=gpt-5.4-mini

# Optional retrieval override (FTS5 is default; literal is the scanner reference and compatibility fallback)
# ROZE_SEARCH=literal
