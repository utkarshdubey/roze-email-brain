# Google OAuth "Desktop app" client (Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OpenAI API key (platform.openai.com)
OPENAI_API_KEY=

# Optional model overrides (defaults in src/llm/models.ts)
# ROZE_MODEL_ANSWER=gpt-5.4          # gpt-5.4-mini answers at a third of the cost with markedly lower accuracy on multi-thread questions
# ROZE_MODEL_EXTRACT=gpt-5-nano
# ROZE_MODEL_PROMOTE=gpt-5.4-mini
# ROZE_MODEL_TAG=gpt-5-nano
# ROZE_MODEL_JUDGE=gpt-5.4-mini

# Optional retrieval override (FTS5 is default; literal is the scanner reference and compatibility fallback)
# ROZE_SEARCH=literal
