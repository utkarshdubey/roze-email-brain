{
  "name": "roze-email",
  "version": "0.1.0",
  "description": "Turn your Gmail history into a small, verifiable memory for a personal AI assistant.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "roze": "./bin/roze.js"
  },
  "scripts": {
    "roze": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts",
    "validate": "tsx bench/validateCitations.ts && tsx bench/validateConcepts.ts"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "picocolors": "^1.1.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
